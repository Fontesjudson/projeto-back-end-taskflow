generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model clientes {
  id              Int       @id @default(autoincrement())
  nome            String    @db.VarChar(100)
  data_nascimento DateTime  @db.Date
  pedidos         pedidos[]
}

model comentarios {
  id         Int       @id @default(autoincrement())
  texto      String
  tarefa_id  Int
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
}

model pedidos {
  id           Int            @id @default(autoincrement())
  data         DateTime?      @db.Timestamp(6)
  idcliente    Int?
  clientes     clientes?      @relation(fields: [idcliente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidositens pedidositens[]
}

model pedidositens {
  id         Int       @id @default(autoincrement())
  idpedido   Int?
  idproduto  Int?
  valor      Decimal   @db.Decimal(18, 2)
  desconto   Decimal   @db.Decimal(18, 2)
  quantidade Decimal   @db.Decimal(18, 2)
  pedidos    pedidos?  @relation(fields: [idpedido], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produtos   produtos? @relation(fields: [idproduto], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model prioridades {
  id               Int        @default(autoincrement())
  descricao        String?    @db.VarChar(20)
  criado_em        DateTime[] @db.Timestamp
  ativo            Boolean?
  prioridade_baixa String
  prioridade_media String
  prioridade_alta  String
  usuario_id       Int        @id(map: "prioridades_pk") @default(autoincrement())
  projeto_id       Int        @default(autoincrement())
}

model produtos {
  id              Int             @id @default(autoincrement())
  descricao       String?         @db.VarChar(100)
  idunidademedida Int?
  pedidositens    pedidositens[]
  unidadesmedida  unidadesmedida? @relation(fields: [idunidademedida], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model projetos {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(100)
  descricao  String?
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tarefas    tarefas[]
}

model tarefas {
  id           Int       @id @default(autoincrement())
  texto        String
  coluna       String    @default("todo") @db.VarChar(10)
  ordem        Int       @default(0)
  projeto_id   Int
  usuario_id   Int
  criado_em    DateTime? @default(now()) @db.Timestamp(6)
  iniciada_em  DateTime? @db.Timestamp(6)
  concluida_em DateTime? @db.Timestamp(6)
  idprioridade Int       @default(autoincrement())
  projetos     projetos  @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios     usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model teste {
  id          Int           @id @default(autoincrement())
  nome        String        @db.VarChar(100)
  descricao   String?       @db.VarChar(1000)
  teste_filho teste_filho[]
}

model teste_filho {
  id         Int      @id @default(autoincrement())
  id_teste   Int?
  quantidade Decimal? @db.Decimal(10, 2)
  teste      teste?   @relation(fields: [id_teste], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model unidadesmedida {
  id        Int        @id @default(autoincrement())
  sigla     String     @db.VarChar(3)
  descricao String?    @db.VarChar(30)
  produtos  produtos[]
}

model usuarios {
  id       Int        @id @default(autoincrement())
  nome     String?    @db.VarChar(50)
  email    String     @db.VarChar(50)
  senha    String?    @db.VarChar(10)
  projetos projetos[]
  tarefas  tarefas[]
}
